############################################
# BridgePay `apps/web` - Environment Example
#
# Copy to `apps/web/.env` for local dev, or set these
# in Vercel Project → Settings → Environment Variables.
############################################

# --- REQUIRED (app will fail without these) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-32+chars-minimum

# --- Recommended for production ---
# Base URL of the deployed app (used for links/callback URLs)
APP_URL=https://your-app.vercel.app

# Redis (queues / caching / health checks)
REDIS_URL=redis://default:password@host:6379

# Comma-separated origins for CORS (if you call API routes cross-domain)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:4000

# --- Public (Vite exposes variables with NEXT_PUBLIC_) ---
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz
NEXT_PUBLIC_CREATE_HOST=localhost:4000
NEXT_PUBLIC_PROJECT_GROUP_ID=
NEXT_PUBLIC_CREATE_API_BASE_URL=

# --- Email (optional, for invoice notifications) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bridge <noreply@yourdomain.com>

# --- Payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Lemonade / M-Pesa (optional) ---
LEMONADE_BASE_URL=https://api-v1.lemonade.services/api/v2
LEMONADE_CONSUMER_KEY=
LEMONADE_CONSUMER_SECRET=
LEMONADE_CLIENT_ID=
LEMONADE_CLIENT_SECRET=
LEMONADE_RELAY_URL=
LEMONADE_RELAY_KEY=

# --- Feature flags / debug ---
SKIP_CSRF_CHECK=false
DEBUG_CIRCUIT_BREAKER=false
# Workers must run in a dedicated process (not inside Vercel serverless functions)
ENABLE_QUEUE_WORKERS=false


